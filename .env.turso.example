# TURSO DATABASE CONFIGURATION
# Get these values from:
# 1. TURSO_CONNECTION_URL: turso db create rodb-news (output shows libsql://...)
# 2. TURSO_AUTH_TOKEN: turso db tokens create rodb-news (output shows token)

TURSO_CONNECTION_URL=libsql://rodb-news-YOUR_USERNAME.turso.io
TURSO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE

# EXISTING CONFIGURATION (keep these)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# JWT SECRETS (Generate these with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_SECRET=your_admin_secret_here_min_32_chars

# Session & Security
SESSION_SECRET=your_session_secret_here_min_32_chars
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# OPTIONAL
ORG_NAME=Routine of Dhulikhel Banda
ORG_EMAIL=rodb.dhulikhel@gmail.com
LOG_LEVEL=info
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
